# Raydium-LP1 local secrets/settings file.
# Copy this to .env with scripts\setup_wizard.ps1. Never commit your real .env.
RAYDIUM_API_BASE=https://api-v3.raydium.io
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: comma-separated fallback RPCs. Private provider URLs with API keys belong here, not in GitHub.
SOLANA_RPC_URLS=https://solana-rpc.publicnode.com,https://solana.drpc.org

# --- Wallet (import with .\scripts\import_wallet.ps1) ---------------------
# Written to BOTH .env and config/settings.json (wallet_address).
WALLET_ADDRESS=
# Optional: base58 secret or array string — .env ONLY, never commit.
WALLET_PRIVATE_KEY=
# Optional: Solana CLI keypair JSON file (used by trade_submit / CLMM node).
# Example: C:\Users\You\.config\solana\id.json
SOLANA_KEYPAIR_PATH=
