"""Dashboard text/json helpers for the Raydium-LP1 scanner."""

from __future__ import annotations

import json
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

DEFAULT_DASHBOARD_PATH = Path("reports/dashboard.json")


def build_dashboard(
    *,
    config: Any,
    report: dict[str, Any],
    rpc_health: list[dict[str, Any]] | None = None,
    alerts_path: Path | None = None,
) -> dict[str, Any]:
    rpc_health = rpc_health or []
    alerts: list[Any] = []
    if alerts_path is not None and alerts_path.exists():
        try:
            alerts = json.loads(alerts_path.read_text(encoding="utf-8"))
        except (OSError, ValueError, json.JSONDecodeError):
            alerts = []

    config_view = {}
    if config is not None:
        if hasattr(config, "__dict__"):
            config_view = dict(config.__dict__)
        else:
            try:
                config_view = dict(config)
            except Exception:
                config_view = {"value": str(config)}

    return {
        "generated_at": datetime.now(UTC).isoformat(),
        "config": config_view,
        "report": report,
        "rpc_health": rpc_health,
        "alerts": alerts,
    }


def write_dashboard(data: dict[str, Any], path: Path = DEFAULT_DASHBOARD_PATH) -> None:
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(_json_safe(data), indent=2, sort_keys=True) + "\n", encoding="utf-8")


def print_dashboard(data: dict[str, Any]) -> None:
    report = data.get("report") or {}
    print("Dashboard")
    print(f"Generated: {data.get('generated_at', '')}")
    print(f"Scanned: {report.get('scanned_count', 0)}")
    print(f"Candidates: {report.get('candidate_count', 0)}")
    print(f"Rejected: {report.get('rejected_count', 0)}")
    if report.get("momentum_enabled"):
        print(f"Momentum hot list: {len(report.get('momentum_hot_top') or [])}")

